{
  "name": "srapsware-website",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "pnpm": {
    "overrides": {
      "got@<11.8.5": ">=11.8.5",
      "postcss": "8.5.29"
    }
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.js",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:images:dry": "node scripts/optimize-images.js --dry-run",
    "optimize:images:backup": "node scripts/optimize-images.js --backup",
    "optimize:images:force": "node scripts/optimize-images.js --force",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "prebuild": "node scripts/routes.mjs && node --import tsx scripts/check-inner-content.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:content": "node --import tsx scripts/check-inner-content.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@types/nodemailer": "^7.0.4",
    "@types/prismjs": "^1.26.5",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.1.0",
    "gsap": "^3.14.2",
    "js-yaml": "^4.3.2",
    "next": "^15.5.28",
    "nodemailer": "^10.1.7",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-turnstile": "^1.1.4",
    "rehype-prism-plus": "^2.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/swc-wasm-nodejs": "^15.1.3",
    "@types/google.maps": "^3.58.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.23",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "glob": "^13.0.0",
    "imagemin": "^9.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "playwright": "^1.59.1",
    "postcss": "^8.5.23",
    "svgo": "^4.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0 <25"
  }
}

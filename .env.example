# Site Configuration
NEXT_PUBLIC_SITE_URL=https://srapsware.com

# Mailchimp Configuration
# Get your API key from: https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Get your Audience ID from: https://mailchimp.com/help/find-audience-id/
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# Your Mailchimp server prefix (e.g., us1, us2, etc.)
# Find this in your API key or Mailchimp URL
MAILCHIMP_API_SERVER=us1

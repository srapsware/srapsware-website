# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.srapsware.com
# Optional image CDN. A localhost value uses /assets on the current preview origin.
NEXT_PUBLIC_CDN_URL=https://cdn.srapsware.com

# Contact form: configure these in Vercel, then redeploy.
# Public key is embedded at build time. Never put secret keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.srapsware.com,srapsware.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=contact@srapsware.com

# Optional: GitHub OAuth for the existing Decap CMS.
# Register callback https://www.srapsware.com/api/auth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Mailchimp Configuration
# Get your API key from: https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Get your Audience ID from: https://mailchimp.com/help/find-audience-id/
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# Your Mailchimp server prefix (e.g., us1, us2, etc.)
# Find this in your API key or Mailchimp URL
MAILCHIMP_API_SERVER=us1
# Google Maps Configuration
# Get your API key from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
